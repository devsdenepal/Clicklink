# Backend environment variables example
CLICKUP_CLIENT_ID=your_clickup_client_id
CLICKUP_CLIENT_SECRET=your_clickup_client_secret
REDIRECT_URI=http://localhost:5000/auth/callback
FRONTEND_URL=http://localhost:5173

# JWT secret used to sign auth tokens (set to a long random string in production)
JWT_SECRET=replace_with_a_long_random_secret

# ClickUp configuration
# Default ClickUp list ID used when the frontend does not pass list_id
CLICKUP_LIST_ID=901812428604
# Optional: Parent task ID where GitHub issues will be created as subtasks
CLICKUP_TASK_FOR_REPO=
# Optional: Explicit status to set when creating subtasks (must be a valid status for the target list)
CLICKUP_SUBTASK_STATUS=
# If you use custom task IDs in ClickUp, enable this and provide your team id
CLICKUP_CUSTOM_TASK_IDS=false
CLICKUP_TEAM_ID=

# GitHub configuration
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
# Optional: Comma-separated list of repos to sync when /api/github/sync is called without ?repo=
# Example: owner1/repo1,owner2/repo2
GITHUB_SYNC_REPOS=
# Optional: Polling/sync interval (seconds) if you add a scheduler
GITHUB_POLL_INTERVAL_SECONDS=300

# Proxy configuration (optional)
# HTTPS_PROXY=https://username:password@proxy-host:proxy-port

# Server
PORT=5000
